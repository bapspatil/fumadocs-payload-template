# Next.js public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_DATABASE_URI=mongodb://localhost:27017/payload-cms

# Optional MongoDB TLS (leave unset for local MongoDB and typical Atlas SRV URIs)
PAYLOAD_DATABASE_TLS=false
PAYLOAD_DATABASE_CA_FILE=
PAYLOAD_DATABASE_CERT_FILE=
PAYLOAD_DATABASE_KEY_FILE=

# S3 storage (Cloudflare R2, AWS S3, or compatible)
# Disabled when S3_BUCKET is empty or S3_ENABLED=false
S3_ENABLED=true
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
